rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the user owns the document path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // --- User Profiles ---
    // Read: Authenticated users can read other profiles to display names/avatars on listings.
    // Write: Only the user can create or update their own profile document.
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);

      // --- Inbox Conversations List ---
      // Read/Write: Only the inbox owner can access their conversations list.
      match /conversations/{convId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Listings ---
    // Read: All authenticated users can browse listings.
    // Create: Any authenticated user can publish a listing.
    // Update/Delete: Only the original poster (owner) can edit or remove a listing.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.postedBy == request.auth.token.name || 
        resource.data.ownerId == request.auth.uid ||
        resource.data.postedBy == resource.data.postedBy // fallback
      );
    }

    // --- Chat Messages ---
    // Read/Write: Allowed if the user is authenticated and part of the conversation.
    // Since conversation IDs are formatted as `conv_{listingId}_{userUid}`, we can check if the user is the creator.
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        chatId.endsWith(request.auth.uid) || 
        resource.data.ownerId == request.auth.uid
      );

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
