rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the user owns the document path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper: Check if the user is an approved admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Admin Profiles ---
    // Any authenticated user can create their admin request (isAdmin starts false)
    // Only the admin themselves or another admin can read their own doc
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    // --- User Profiles ---
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
      allow update, delete: if isAdmin();

      match /conversations/{convId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Listings ---
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.postedByUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.postedBy == request.auth.token.name || 
        resource.data.ownerId == request.auth.uid ||
        resource.data.postedByUid == request.auth.uid
      );
      // Admins can update/delete any listing
      allow update, delete: if isAdmin();
    }

    // --- Chat Messages ---
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        chatId.matches('.*' + request.auth.uid) || 
        get(/databases/$(database)/documents/listings/$(chatId.split('_')[1])).data.postedByUid == request.auth.uid
      );

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid) || 
          get(/databases/$(database)/documents/listings/$(chatId.split('_')[1])).data.postedByUid == request.auth.uid
        );
      }
    }
  }
}
